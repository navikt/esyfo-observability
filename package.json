{
  "name": "esyfo-observability",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm --filter './packages/*' -r run build",
    "typecheck": "pnpm --filter './packages/*' -r run typecheck && tsc -p tsconfig.test.json",
    "test": "pnpm --filter @navikt/esyfo-logger-testkit prepare:contracts && vitest run && node --test scripts/*.test.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "pack:check": "node scripts/check-packages.mjs",
    "check": "pnpm check:contracts && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check"
  },
  "devDependencies": {
    "@navikt/next-logger": "5.0.1",
    "@navikt/pino-logger": "5.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "pino": "10.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
